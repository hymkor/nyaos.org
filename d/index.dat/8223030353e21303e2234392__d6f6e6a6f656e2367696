sub ls_core{
    my $opt = shift;
    my @list;
    push(@_,"*") unless @_;

    foreach (@_){
	my $pat=$_;
	$pat =~ s/([^\*\?])/unpack("h*",$1)/eg;
	$pat =~ s/\?/../g;
	$pat =~ s/\*/.*/g;
	$pat = '^' . $pat . '$';
	push(@list, map({ fname  => $_ ,
		          title  => &fname2title($_) ,
			  mtime  => &mtime($_) 
			} , grep($_ =~ $pat, &list_page() ) ) );
    }
    if( exists $opt->{t} ){
	@list = sort{ $a->{mtime} cmp $b->{mtime} } @list;
    }else{
	@list = sort{ $a->{title} cmp $b->{title} } @list;
    }
    if( exists $opt->{r} ){
	@list = reverse @list;
    }
    if( exists $opt->{countdown} ){
	splice(@list,$opt->{countdown} );
    }
    @list;
}

sub parse_opt{
    my $opt=shift;
    my $arg=shift;
    foreach my $p (@_){
	if( $p =~ /^-(\d+)$/ ){
	    $opt->{countdown} = $1;
	}elsif( $p =~ /^-/ ){
	    $opt->{$'} = 1;
	}else{
	    push(@{$arg},$p);
	}
    }
}

