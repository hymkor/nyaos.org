sub a_pwd{ ### Password Change ###
    my $p1 = $::form{'p1'};
    my $p2 = $::form{'p2'};
    &ninsho;
    if( $p1 ne $p2 ){ die("!New signs differ from each other!"); }
    $::config{crypt} = crypt($p1,"wk");
    &save_config;
    &transfer_url($::me);
}

sub a_preferences{
    &ninsho;
    $::config{locallink} = ( $::form{"locallink"} eq "OK" ? "OK" : "NG" );
    $::config{lonely}    = ( $::form{"lonely"}    eq "OK" ? "OK" : "NG" );
    $::config{sitename}  = $::form{"sitename"};
    &save_config;
    &transfer_url($::me);
}

sub a_ren{
    &ninsho;
    my $newtitle = $::form{"newtitle"};
    my $title    = $::form{"p"};
    my $fname    = &title2fname($title);
    my $newfname = &title2fname($newtitle);

    foreach my $fn ( &directory() ){
	my @p=split("__",$fn);
	if( $p[0] eq $fname ){
	    $p[0] = $newfname;
	    rename( $fn , join("__",@p) );
	}
    }
    &transfer_page($newtitle);
}

sub a_seek{
    my $keyword=$::form{'keyword'};
    my $ekeyword=&enc( $keyword );

    &print_header( title=>"Seek: \"${ekeyword}\"" , userheader=>'YES' );

    &puts('<ul>');
    foreach my $fn ( &list_page() ){
	my $title  = &fname2title( $fn );
	my $url    = &title2url( $title );
	if( index($title ,$keyword) >= 0 ){
	    &putenc('<li><a href="%s">%s</a> (title)</li>'
