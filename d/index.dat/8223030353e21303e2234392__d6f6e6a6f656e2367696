### File I/O

sub is_frozen{
    if( -r &title2fname($_[0] || $::form{'p'}) ){
	! -w _;
    }else{
	$::config{'lonely'} eq 'OK';
    }
}

sub ninsho{
    if( $::config{crypt} ne '' &&
        crypt($::form{'password'},'wk') ne $::config{crypt} &&
        crypt($::form{'qassword'},'wk') ne $::config{crypt} )
    {
	die("!Administrator's Sign is wrong!");
    }
}

sub check_frozen{
    if( $::form{'u'} eq 'admin' ){ ### Administrator mode ###
	 &ninsho;
    }elsif( is_frozen() ){ ### User ###
	die( '!This page is frozen.!');
    }
}
sub check_conflict{
    my $stamp_time = &title2mtime($::form{'p'});
    my $begin_time = $::form{'stamp'};
    if( $begin_time ne $stamp_time ){
	die( "!Someone else modified this page on ${stamp_time}".
	     " after you began to edit on ${begin_time}!"  );
    }
}

# read object with OBJECT-NAME(S) , not filename.
sub read_object{
    if( open(FP,&title2fname(@_) ) ){
	my @honbun = <FP>;
	close(FP);
	join('',@honbun);
    }else{
	'';
    }
}

# write object with OBJECT-NAME(S) , not filename.
sub write_object{
    my $body  = pop(@_);
    my $fname = &title2fname(@_);

    if( length($body) <= 0 &&
	scalar( grep(index($_,$fname)==0 , &directory()) ) == 1 )
    {
	unlink $fname;
	&cacheoff;
	0;
    }else{
	open(FP,">${fname}") || die("can't write the file ${fname}.");
	    binmode(FP);
	    print FP $body;
	close(FP);
	&cacheoff;
	1;
    }
}

