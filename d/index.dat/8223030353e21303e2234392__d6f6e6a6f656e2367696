### CGI input/output interface ###
##################################

sub read_multimedia{
    my ($query_string , $cutter , $form ) = @_;

    my @blocks = split("\r\n${cutter}","\r\n$query_string");
    foreach my $block (@blocks){
	$block =~ s/\A\r?\n//;

	my ($header,$body) = split(/\r?\n\r?\n/,$block,2);
	my ($type,$name,$fname) = ( '' , 'notitle' , 'attach.bin' );

	if( $header =~ /^Content-Disposition:\s+form-data;\s+name=\"(\w+)\"/i){
	    $name = $1;
	    if( $header =~ /filename="([^\"]+)"/ ){
		$fname = ( split(/[\/\\]/,$1) )[-1];
	    }
	}
	if( $header =~ /^Content-Type: image\/(\w+)/ ){
	    $type = $1;
	}

	$form->{ $name } = $body;
	$form->{ "${name}.type" }     = $type   if length($type) > 0;
	$form->{ "${name}.filename" } = $fname;
    }
}

sub read_form{
    my $form=shift;
    my $query_string;
    if( exists $ENV{'REQUEST_METHOD'} && $ENV{'REQUEST_METHOD'} eq 'POST' ){
	if( $ENV{'CONTENT_LENGTH'} > 1024*1024 ){ # 1 MegaBytes
	    die('Too large form data');
	}
	read(STDIN, $query_string, $ENV{'CONTENT_LENGTH'});
	if( $query_string =~ /\A(-------.*?)\r?\n/ ){
	    &read_multimedia($query_string,$1,$form);
	    return;
	}
    } else {
	$query_string = ($ENV{'QUERY_STRING'} || '');
    }
    foreach my $p ( split(/[&;]/, $query_string) ){
	my ($name, $value) = split(/=/, $p,2);
	unless( defined($value) ){ $value = '' ; }
	$value =~ s/\+/ /g;
	$value =~ s/%([0-9a-fA-F][0-9a-fA-F])/pack('C', hex($1))/eg;
	$form->{$name} = $value;
    }
}

sub puts{
    grep(($::print .= "$_\r\n",0),@_);
}
# puts with auto escaping arguments but format-string.
sub putenc{
    my $fmt=shift;
    $::print .= sprintf("$fmt\r\n",map(&enc($_),@_));
}

sub flush{
    print $::print;
}

############################
### Conversion functions ###
############################

sub errmsg{
    '<h1>Error !</h1><pre>'
    . &enc( $_[0] =~ /^\!([^\!]+)\!/ ? $1 : $_[0] )
    . '</pre>';
}

sub enc{
    my $s = shift;
    $s =~ s/&/\&amp;/g;
    $s =~ s/</\&lt;/g;
    $s =~ s/>/\&gt;/g;
    $s =~ s/"/\&quot;/g;
    $s =~ s/'/\&#39;/g;
    $s =~ s/\r//g;
    $s;
}
sub denc{
    my $s = shift;
    $s =~ s/\&#39;/'/g;
    $s =~ s/\&lt;/</g;
    $s =~ s/\&gt;/>/g;
    $s =~ s/\&quot;/\"/g;
    $s =~ s/\&amp;/\&/g;
    $s;
}

sub yen{ # to save crlf-code into hidden.
    my $s = shift;
    $s =~ s/\\/\\y/g;
    $s =~ s/\r/\\r/g;
    $s =~ s/\n/\\n/g;
    $s ;
}

sub deyen{
    my $s = shift;
    $s =~ s/\\n/\n/g;
    $s =~ s/\\r/\r/g;
    $s =~ s/\\y/\\/g;
    $s ;
}

sub mtime{
    my $fn=shift;
    if( exists $mtime_cache{ $fn } ){
	$mtime_cache{ $fn };
    }else{
	my ($sec,$min,$hour,$mday,$month,$year) = localtime((stat($fn))[9]);
	$mtime_cache{ $fn } =
	    sprintf('%04d/%02d/%02d %02d:%02d:%02d' ,
		    1900+$year,1+$month,$mday,$hour,$min,$sec);
    }
}
sub cacheoff{
    %mtime_cache = ();
    @work_directory_cache = ();
}
sub title2mtime{
    &mtime( &title2fname(@_) );
}
sub fname2title{
    my @r=map( pack('h*',$_) , split(/__/,$_[0]) );
    wantarray() ? @r : $r[0] ;
}
sub title2fname{
    join('__',map(unpack('h*',$_),@_) );
}
sub percent{
    my $e_title = shift;
    $e_title =~ s/([^\w\'\.\-\*\(\)\_ ])/sprintf('%%%02X', unpack('C', $1))/eg;
    $e_title =~ s/ /+/g;
    $e_title;
}

sub title2url{
    "$::me?p=" . &percent( $_[0] || 'FrontPage' );
}

sub attach2url{
    sprintf('%s?p=%s;f=%s',$::me,&percent($_[0]),&percent($_[1]));
}

