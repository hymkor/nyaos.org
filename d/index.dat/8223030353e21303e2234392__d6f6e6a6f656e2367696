sub preprocess{
    my ($text,$session) = @_;
    my $attachment = $session->{attachment};

    my $RXURL  = q{(?:s?https?|ftp)://[-\w.!~*'();/?:@&=+$,%#]+} ;

    ## << style
    $text =~ s|&gt;&gt;\{([^\}]+)\}|&inner_link($1,$1)|ge;

    ## [[...]] style
    $text =~
    s!\[\[(([^\|\]]+)\|)?([^\]|]+)\]\]!&inner_link(defined($1)?$2:$3,$3)!ge;

    ### http://...{ ... } style
    $text =~ s/(${RXURL})\{([^\}]+)\}/<a href="$1">$2<\/a>/go;

    ### [...|http://...] style
    if( $::config{"locallink"} eq "OK" ){
	$text =~
	s!\[([^\|]+)\|((?:s?https?|ftp|file)://[^\]]+)\]!<a href="$2">$1</a>!g;
    }else{
	$text =~
	s!\[([^\|]+)\|((?:s?https?|ftp)://[^\]]+)\]!<a href="$2">$1</a>!g;
    }

    ### attachment ###
    $text =~ s|&lt;&lt;\{([^\}]+)\}|
	exists $attachment->{$1}
	? $attachment->{$1}->{tag}
	: "<blink>&lt;&lt;{$1}?</blink>"|ge;

    ### tag listed white list ###
    $text =~ s!&lt;(/?(b|big|br|code|del|dfn|em|hr|i|ins|kbd|q|s|samp|small|span|strike|strong|sup|sub|tt|u|var)\s*/?)&gt;!<$1>!gi;

    ### text decorations ###
    $text =~ s|&#39;&#39;&#39;(.*?)&#39;&#39;&#39;|<strong>$1</strong>|gs;
    $text =~ s|&#39;&#39;(.*?)&#39;&#39;|<em>$1</em>|gs;
    $text =~ s|__(.*?)__|<u>$1</u>|gs;
    $text =~ s|==(.*?)==|<strike>$1</strike>|gs;
    $text =~ s|^//.*$||mg;

    #### plugin ###
    $text =~ s/\(\((.+?)\)\)/&plugin($session,$1)/ges;

    ### raw url
    $text = " $text";
    $text =~ s/([^-\"\>\w\.!~'\(\);\/?\@&=+\$,%#])(${RXURL})/$1<a href="$2">$2<\/a>/go;
    substr($text,0,1)='';

    $text;
}

sub midashi{
    my ($depth,$text,$session)=(@_);
    $text = &preprocess($text,$session);
    my $section = ($session->{section} || ($session->{section}=[0,0,0,0,0])) ;

    if( $depth < 0 ){
	&puts( "<h1>$text</h1>" );
    }else{
	grep( $_ && &puts('</div></div>'),@{$section}[$depth .. $#{$section}]);
	$section->[ $depth ]++;
	grep( $_ = 0 , @{$section}[$depth+1 .. $#{$section} ] );

	my $tag = join('.',@{$section}[0...$depth]);
	$text =~ s/^\+/${tag}. /;
	my $h = 2+$depth;
	&putenc('<div class="%ssection">' , 'sub' x $depth );
	if( $session->{index} ){
	    &puts( qq(<h$h id="p$tag">$text</h$h>) );
	}else{
	    &puts( qq(<h$h>$text</h$h>) );
	}
	&putenc('<div class="%ssectionbody">' , 'sub' x $depth );
    }
}

sub syntax_engine{
    my ($html,$session) = @_;
    my $cont = 0;
    my $anchor_count=0;

    my @fragment = split(/\r?\n\r?\n/,$html);
    foreach my $fragment (@fragment){
	if( $cont || $fragment=~ m!\A\s*((\&lt;pre&gt;)|(\-*(8\&lt;\-*)+))!i ){
	    ### verbatim block ###
	    if( $cont ){
		$fragment = "\n${fragment}";
	    }else{
		$fragment = "<pre>$'";
	    }
	    if( $fragment =~ m!((&lt;/pre&gt;)|((\-*\&gt;8)+\-*))\s*\Z!i ){
		$fragment = "$`</pre>";
		$cont = 0;
	    }else{
		$cont = 1;
	    }
	    &puts( $fragment );
	}elsif( $fragment =~ /\A\s*[\*\+]/ ){
	    ### parse the list block
 	    my @list;
 	    foreach(split(/\n/,&preprocess($fragment,$session) ) ){
 		if( /\A\s*[\*\+]+/ || $#list < 0 ){
 		    push(@list,$_);
 		}else{
 		    $list[$#list] .= $_;
 		}
 	    }
	    ### expand list ###
	    my @stack=();
	    foreach (@list){
		my ($mark,$text)=(/\A\s*((\*+)|(\++))/ ? ($1,$') : ('',$_) );
		my $nest=length($mark);
		if( $nest > scalar(@stack) ){### more deep ###
		    while( $nest > scalar(@stack) ){
			if( $mark =~ /\+/ ){
			    &puts("<ol><li>" ); push(@stack,"</li></ol>");
			}else{
			    &puts("<ul><li>" ); push(@stack,"</li></ul>");
			}
		    }
		    &puts( $text ) if $nest > 0;
		}else{
		    &puts( pop(@stack) ) while scalar(@stack) > $nest;
		    &puts( "</li>" ) if scalar(@stack) > 0;
		    &puts("<li>${text}") if $nest > 0 ;
		}
	    }
	    &puts( pop(@stack) ) while scalar(@stack) > 0;

	}elsif( $fragment =~ /\A\s*\:/ ){
	    ### <DL>...</DL> block ###
	    my @s=split(/\n\s*:/, &preprocess($',$session) );
	    &puts('<dl>');
	    &puts( map( /^:/ ? "<dd>$'</dd>\r\n" : "<dt>$_</dt>\r\n" , @s) );
	    &puts('</dl>');
	}elsif( $fragment =~ /\A\s*((?:\&lt;){2,6})(.*?)(?:\&gt;){2,6}\s*\Z/s ){
	    ### <Hn>...</Hn> block ###
	    &midashi( length($1)/4-2 , $2 , $session );
	}elsif( $fragment =~ /\A\s*(\!{1,4})(.*)\Z/s ){
	    &midashi( 3 - length($1) , $2 , $session );
	}elsif( $fragment =~ /\A\s*\&gt;&gt;\s*(.*)\s*\&lt;\&lt;\s*\Z/ ){
	    my $s=&preprocess($1,$session);
	    &puts(qq(<p class="centering" align="center">$s</p>));
	}elsif( $fragment =~ /\A&quot;&quot;/s ){
	    $fragment =~ s/^&quot;&quot;//gm;
	    &puts( '<blockquote>' ,
		       &preprocess($fragment,$session) ,
		   '</blockquote>' );
	}elsif( $fragment =~ /\A\s*\|\|/ ){
	    &puts('<table>');
	    foreach my $tr ( split(/\|\|/,&preprocess($',$session) ) ){
		&puts('<tr>');
		my $tag='td';
		if( $tr =~ /\A\|/ ){
		    $tag = 'th'; $tr = $';
		}
		&puts( map("<${tag}>$_</${tag}>",split(/\|/,$tr) ),'</tr>' );
	    }
	    &puts('</table>');
	}elsif( $fragment =~ /\A\s*&lt;((?:blockquote)|(?:center))&gt;(.*)&lt;\/\1&gt;\s*\Z/si ){
	    &puts( "<$1>",&preprocess($2,$session),"</$1>" );
	}elsif( $fragment =~ /\A\s*\-\-\-+\s*\Z/ ){
	    &puts( '<hr>' );
	}elsif( (my $s = &preprocess($fragment,$session)) !~ /^\s*$/s ){
	    if( $s =~ /\A\s*<(\w+).*<\/\1[^\/]*>\s*\Z/si ){
		&puts( "<div>${s}</div>" );
	    }else{
		&puts("<p>${s}</p>");
	    }
	}
    }
    if( exists $session->{section} ){
	my $sec= $session->{section};
	grep( $_ && &puts('</div></div>'),@{$sec});
    }
    &plugin_footnote_flush($session);
}
