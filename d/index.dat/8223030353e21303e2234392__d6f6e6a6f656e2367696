sub load_config{
    my $settings=&read_object('','password');
    if( $settings ne '' ){
	my @settings = split(/\n/,$settings);
	$::config{crypt}    = $settings[0] if defined($settings[0]) && $settings !~ /\t/ ;
	$::config{sitename} = $settings[1] if defined($settings[1]) && $settings !~ /\t/ ;
	foreach my $line (@settings){
	    if( $line =~ /^(\S+)\t(.*)$/ ){
		$::config{ $1 } = $2;
	    }
	}
	1;
    }else{
	0;
    }
}
sub save_config{
    my @settings=();
    while( my ($key,$val)=each %::config ){
	push(@settings,"${key}\t${val}\n");
    }
    &write_object( "" , "password" , join("", @settings ) );
}

