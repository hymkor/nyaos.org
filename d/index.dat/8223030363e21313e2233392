<<[python] TCPSocket クラスを作ってみる>>

Ruby の TCPSocket クラスは、単なるラッパーながらお手軽で羨しいので、
Python で似たようなものを作れないかと挑戦してみた！

8<
#!/usr/bin/python

import socket

class TCPSocket :
    def __init__(self,ip,port):
        self.socket = socket.socket( socket.AF_INET , socket.SOCK_STREAM )
        self.socket.connect( (ip , port) )
        self.fd = self.socket.makefile()

    def close(self):
        if self.fd :
            self.fd.close()
            self.fd = None
            self.socket.close()
            self.socket = None

    def write(self,s):
        self.fd.write(s)
        self.fd.flush()

    def readline(self):
        return self.fd.readline()

http = TCPSocket("www.yahoo.co.jp",80)
http.write("GET / http/1.1\r\n")
http.write("Host: www.yahoo.co.jp\r\n\r\n")
line = http.readline()
while line != "" :
    print line,
    line = http.readline()

http.close()
