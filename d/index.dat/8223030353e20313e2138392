と、http://nyaos.org/d/?date=20050117#c02{Mr.F もおっしゃる}ので、
なんとか根性出して、自力で、標準/ファイル出力する際に SJIS 化する
フィルタークラス SJIStream を作ってみました。

<pre>
private import std.stream;
private import std.string;

extern(Windows) export int WideCharToMultiByte(
     uint  CodePage,
     uint  dwFlags,
     char* lpWideCharStr,
     int   cchWideChar,
     char* lpMultiByteStr,
     int   cbMultiByte,
     char* lpDefaultChar,
     bool* lpUsedDefaultChar );

class SJIStream : Stream {
    Stream base;

    this( Stream base1 ){
	base = base1;
    }
    uint readBlock(void *buffer,uint size){
	return base.readBlock(buffer,size);
    }
    ulong seek(long offset, SeekPos rel){
	return base.seek(offset,rel);
    }

    void write(wchar[] ws){
	auto ubyte[]   result;

	result.length = WideCharToMultiByte(
	    0, 0, cast(char*)(ws.ptr), ws.length ,
	    null, 0, null, null);

	WideCharToMultiByte(
	    0, 0, cast(char*)(ws.ptr), ws.length ,
	    cast(char*)( result.ptr ), result.length, null, null);

	base.writeBlock( result.ptr , result.length  );
    }
    void write(char[] s){
	write( std.utf.toUTF16(s) );
    }

    uint writeBlock(void *buffer,uint size){
	auto char[] s;
	s.length   = size;
	s[0..size] = (cast(char*)( buffer ))[0..size];
	write( s );
	return size;
    }
    static SJIStream jout;
    static this(){
	jout=new SJIStream(std.stream.stdout);
    }
}
alias SJIStream.jout jout;

/++++
void main(){
    jout.writeLine("あいうえお");
    SJIStream fp=new SJIStream( new File("hoge",FileMode.Out) );
    // File fp = new File("hoge",FileMode.Out);
    fp.writef("ほげほげ[%s]\n","いひひ");
    fp.close();
}
++++/
