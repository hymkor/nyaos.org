<pre>
    #include "d33.h"
    
    using namespace oracle::occi;
    
    Connection *D33::D33Appl::login(
	const string &user ,
	const string &passwd ,
	const string &dbname )
    {
	try{
	    if( env_ == 0 )
		env_ = Environment::createEnvironment( Environment::DEFAULT );
	    if( conn_ )
		env_->terminateConnection(conn_);
	    conn_ = env_->createConnection( user , passwd , dbname );
	}catch( SQLException &e ){
	    conn_ = 0;
	    throw D33SQLErr(
		"can not login oracle db [" +
		user + "/.../" + dbname + "] : " +
		e.what() 
	    );
	}
	return conn_;
    }
    
    Connection *D33::D33Appl::login()
    {
	const char *orainfo=getenv("D33ORA");
	if( orainfo == NULL ){
	    throw D33Err( "Not found information to "
			    "login oracle-instance in $D33ORA");
	}
	int c1= strspn(orainfo         ,":");
	if( c1 < 0 ){
	    throw D33Err( "Not found passwd in $D33ORA" );
	}
	int c2= strspn(orainfo+c1+1,":");
	if( c2 < 0 ){
	    throw D33Err( "Not found dbname in $D33ORA" );
	}
	string user( orainfo           , c1-1) ;
	string pwd ( orainfo+c1+1      , c2-1) ;
	string dbn ( orainfo+c1+1+c2+1 );
    
	return login( user , pwd , dbn );
    }
    
    void D33::Query::exec( const string &sql )
    {
	if( stmt_ ){ 
	    if( rs_ ){ stmt_->closeResultSet(rs_); }
	    conn_->terminateStatement( stmt_ );
	}
	try{
	    stmt_=conn_->createStatement( sql_ = sql );
	    rs_=stmt_->executeQuery();
	}catch( SQLException &e ){
	    throw D33SQLErr( "On SQL:[" + sql_ + "]," + e.what() );
	}
    }
    D33::Query::Query( Connection *conn , const string &sql )
	: conn_(conn) , stmt_(0) , rs_(0)
    {
	exec( sql );
    }
    D33::Query::Query( D33::D33Appl &appl , const string &sql )
	: conn_( appl.connection() ) , stmt_(0) , rs_(0)
    {
	exec( sql );
    }
    
    D33::Query::~Query()
    { 
	if( rs_ ){ stmt_->closeResultSet(rs_); }
	if( stmt_ ){ conn_->terminateStatement( stmt_ ); }
    }
