    /* d33.h
     *   アプリケーションフレームワーク標準ヘッダ
     */
    #include <occi.h>
    #include <string>
    
    namespace D33 {
	using namespace oracle::occi;
	using namespace std;
    
	class D33Err : public std::exception{
	    string info_;
	public:
	    D33Err( const string &info ) : info_(info){}
	    D33Err( const D33Err &y ) : info_(y.info_){}
	    virtual ~D33Err() throw() {}
	    const char *what()  const throw(){ return info_.c_str(); }
	};
	class D33SQLErr : public D33Err{
	public:
	    D33SQLErr( const string &info ) : D33Err(info){}
	    D33SQLErr( const D33SQLErr &y ) : D33Err(y){}
	    ~D33SQLErr(){}
	};
    
	class D33Appl {
	    int          argc_;
	    char       **argv_;
	    Environment *env_;
	    Connection  *conn_;
	    
	    /* 複写を禁止する。参照のみ許可 */
	    D33Appl( const D33Appl &y ){}
	public:
	    /* 標準コンストラクタ */
	    D33Appl( int argc , char **argv )
		: argc_(argc) , argv_(argv) , env_(0) , conn_(0){}
	    /* 通常のDBログイン */
	    Connection *login(  const string &user,
				const string &passwd ,
				const string &dbname );
    
	    /* 環境変数 D33ORA を参照した DB ログイン */
	    Connection *login();
	    Connection *connection() { return conn_; }
    
	    const char *operator[](int no) const
		{ return argv_[no]; }
	    int argc() const { return argc_; }
    
	    ~D33Appl(){ if( conn_ ){ env_->terminateConnection(conn_); } }
	};
    
	class Query {
	    string sql_;
	    Connection *conn_;
	    Statement *stmt_;
	    ResultSet *rs_;
	public:
	    Query( Connection *conn ) : conn_(conn) , stmt_(0) , rs_(0) {}
	    Query( D33Appl &appl ) 
		: conn_(appl.connection()),stmt_(0),rs_(0){}
	    void exec( const string &sql_ );
	    Query( Connection *conn , const string &sql );
	    Query( D33Appl &appl , const string &sql );
    
	    bool next(){ return rs_->next(); }
	    ResultSet *operator->(){ return rs_; }
	    ~Query();
	};
    }
