<pre>
    #include <iostream>
    #include <iomanip>
    #include "d33.h"
    
    int main(int argc,char **argv)
    {
	D33::D33Appl appl(argc,argv);
	try{
	    appl.login("******","**","*************");
    
    
	    vector<string> tname;  /* 表の名前を入れる可変長配列 */
	    vector<string> tsname; /* 表領域の名前を入れる可変長配列 */
    
	    for(D33::Query q(appl,
			"select  table_name,tablespace_name "
			"  from  all_tables")
		; q.next() ; )
	    {
		tname .push_back( q->getString(1) );
		tsname.push_back( q->getString(2) );
	    }
    
	    /* 一行目に、テーブルの総数を出力する */
	    cout << setw(5) << tname.size() << endl;
    
	    /* 二行目以降に、配列の保持しているテーブル名を順に出力する */
	    for( int i=0 ; i < tname.size() ; ++i ){
		/* c_str() を付けて、char* 型にわざわざ変換しているのは、
		 * gcc 2.97 のライブラリのバグで、setw が string 型を
		 * 無視してしまう為
		 */
		cout << setiosflags(ios::right) << setw(5) << i << " ";
		cout << setiosflags(ios::left) << setw(30) << tname[i].c_str() ;
		cout << setiosflags(ios::left) << setw(20) << tsname[i].c_str() ;
		cout << endl;
	    }
	}catch( exception &e ){
	    cerr << e.what() << endl;
	}
	return 0;
    }
