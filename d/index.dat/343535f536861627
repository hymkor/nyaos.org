span.htmlcode_3{
    text-align:center;
}

body {
	margin-top: 0px;
	margin-left: 0.4em;
	color: #fff;
	background-color: #840531;
}

div.adminmenu {
	text-align: right;
	margin-top: 0.3em;
	padding-right: 0.5em;
	font-size: 10px;
}

div.adminmenu br { display: none; }

span.adminmenu {
/*	color: #2b2b43;	 */
	background-color:#cb1234;
	border-style: solid;
	border-width: 0px 1px 1px 0px;
	border-color: #2b2b43;
	padding: 1px; 
}

.adminmenu a { 		color : #2b2b43 ; text-decoration:none; }
.adminmenu a:visited{ 	color : #2b2b43 ; }
.adminmenu a:hover { 	color : #e57583 ; text-decoration:none; }

h1 {
/*	margin-top: 128px; */
	margin-bottom: 0.4em;
	margin-right: 0em;
	margin-left: 0.4em;
	text-align: right;
	color: #efd7a5;
}

a{ color: #e57583; background-color: transparent; }
a:visited { color: #e57583; background-color: transparent; }
a:hover { color: white; background-color: transparent; }

.sidebar a{ color:white; text-decoration:none; background-color: transparent; }
.sidebar a:hover { color: #e57583; text-decoration:none;background-color: transparent; }

table.calender a{ color: #e57583; background-color: transparent; }
table.calender a:visited { color: #e57583; background-color: transparent; }
table.calendar a:hover { color: white; background-color: transparent; }
table.calender span.today { background-color:#e57583; }


div.body h3 a {	text-decoration:none; }
div.body h4 a {	text-decoration:none; }

/* main */
div.main {
/*	background-image: url(perlish_logo.png); background-repeat: no-repeat; */
	background-position: 0px 44px;
	margin-top: 0px;
	margin-left: 200px; /* original 150px */
	margin-right: 0.6em;
	padding: 0.0em;
	padding-top: 0em;
	padding-left: 0em;
	/* max-width: 40em; */
	min-width: 480px;
}

div.day hr {
	width: 96%;
	color: #2b2b43;
	background-color: transparent;
}

div.day hr.sep {
	display: none;
	margin: 0px;
}

div.day h2 {
	margin-top: 0.8em;
	margin-bottom: 0.8em;
	font-size: 110%;
	padding-left: 0.6em;
	padding-top: 0.2em;
	padding-bottom: 0.2em;
	color: #ffffff;
	background-color: #000000;
}

div.day p img {
	margin: 0.2em;
	margin-right: 0.8em;
	margin-bottom: 0.8em;
	float : left;
}

div.day p em img {
	margin: 0.2em;
	margin-right: 0.8em;
	margin-bottom: 0.8em;
	float : none;
}

div.day p strong img {
	margin: 0px;
	padding: 0px;
	float : none;
	clear : both;
}

div.day dt img {
	margin: 0.6em;
	float : left;
}

div.day dd img {
	margin: 0.2em;
	margin-right: 0.8em;
	margin-left: 0.6em;
	margin-bottom: 0.6em;
	float : right;
}

div.day dl {
	clear : none;
}

div.main div.day,h2,h3,h4,h5,h6 hr {
	clear : both;
}

div.day h2 a:link, div.main h2 a:visited {
	color: #ffffff;
	background-color: transparent;
	text-decoration: none;
}

div.day {
	margin-right: 0em;
	font-size: 90%;
}

div.day div.section {
	margin-left: 1em;
}

div.day h3 {
	font-size: 110%;
	border-color: #cb1234;
	border-width: 0px 0px 1px 0px;
	border-style: solid;
}

div.day h4 {
	margin-left: 0.6em;
	border-color: #cb1234;
	border-width: 0px 0px 1px 0px;
	border-style: dashed;
	font-size: 100%;
}

div.day h5,h6 {
	margin: 0.0em;
	padding: 0.4em 1em;
	font-size: 100%;
}

div.day p {
	margin-top: 0px;
	margin-bottom: 0.5em;
	margin-left: 1em;
	line-height: 1.5;
}

div.day li {
	line-height: 1.5;
}

div.day ul, div.day dl {
	margin-top: 0.2em;
	margin-left: 3em;
	padding-left: 0em;
}

div.day dt {
	margin-top: 0.5em;
	font-weight: bold;
}

div.day dd {
	margin-left: 2em;
	line-height: 140%;
}

div.day pre {
	white-space: -moz-pre-wrap; /* Mozilla */
	white-space: -pre-wrap;     /* Opera 4-6 */
	white-space: -o-pre-wrap;   /* Opera 7 */
	white-space: pre-wrap;      /* CSS3 */
	word-wrap: break-word;      /* IE 5.5+ */
	background-color: #2b2b43;
	margin-left: 2em;
	padding: 4px;
	clear : both;
}

div.day blockquote {
	white-space: -moz-pre-wrap; /* Mozilla */
	white-space: -pre-wrap;     /* Opera 4-6 */
	white-space: -o-pre-wrap;   /* Opera 7 */
	white-space: pre-wrap;      /* CSS3 */
	word-wrap: break-word;      /* IE 5.5+ */
	border-style: solid;
	border-width: 1px 2px 2px 1px;
	border-color: #2b2b43;
	color: #333333;
	background-color: #f0f0f0;
	padding: 8px;
	padding-top: 8px;
	padding-bottom: 0px;
	clear : both;
}

div.day table {
	margin: 1em;
	border-collapse: collapse;
}

div.day td {
	padding: 2px;
	padding-left: 0.6em;
	padding-right: 0.6em;
	border: thin solid #2b2b43;
}

div.form {
	clear: right;
}

span.corres {
	font-size: 80%;
	font-weight: lighter;
}

div.day span.footnote a {
	font-size: x-small;
	text-decoration: none;
}

div.day p.footnote {
	font-size: small;
}

div.day p.footnote a {
	text-decoration: none;
}

/* sidebar */
div.sidebar {
	background-color: #cb1234;
/*	background-image: url(perlish_sidebar.png); background-repeat: no-repeat; */
	position: absolute;
	top: 0em;
	left: 0px;
	width: 200px;
/*	padding-top: 164px; */
	padding-bottom: 5em;
	color: #fee;
	word-break: break-all;
}

div.sidebar h4 {
	font-size: small;
	padding-right: 8px;
	margin-bottom: 0.2em;
	margin-top: 1em;
	margin-left: 6px;
}

div.sidebar h5 {
	font-size: small;
	padding-right: 8px;
	margin-bottom: 0.2em;
	margin-top: 1em;
	margin-left: 6px;
}

div.sidebar ul {
	margin-top: 0em;
	margin-left: 0em;
	padding-left: 10px;
	padding-right: 8px;
}

div.sidebar li{
	font-size: x-small;
	list-style-type: none;
	margin: 6px 0px;
	line-height: 100%;
}

div.sidebar hr {
	color: #fff;
	background-color: transparent;
	width: 80%;
	margin-bottom: 1em;
}

div.sidebar p {
	margin: 0px;
	padding: 0px;
	font-size: x-small;
}

div.sidebar form {
	margin-top: 0em;
	margin-left: 0.5em;
	margin-right: 4px;
	padding-right: 8px;
	font-size: x-small;
	line-height: 110%;
}

div.sidebar img {
        margin-left: 8px;
	border-style: none;
}

div.sidebar img.rubynokai {
        margin-left: 8px;
	border-style: none;
}

div.sidebar img.rubima_logo {
	position: absolute;
	top: 49px;
	left: 0px;
	margin-left: 0px;
	border-style: none;
}


/* rightbar */

div.footer {
	font-size: 90%;
	text-decoration: none;
	text-align: right;
	margin-right: 1em;
	margin-bottom: 1em;
	padding-top: 36px;
	clear: both;
}

/* hide sanchor */
div.day span.sanchor {
	display: none;
}

div.main h2 {
	color: #ffffff;
	background-color: #cb1234;
}

div.sidebar a:hover {
	color: #e57583;
}

th {
	white-space: nowrap;
	border: thin solid #2b2b43;
}

table.calender{
	font-size:small;
}

div.terminator{
	margin-left: 2em;
	background-color:#2b2b43;
	font-size:80%;
	padding:4pt;
	clear:both;
}
.commentator{
	font-weight:bold;
}

.centering,big{
	font-size:200%;
}

div.update textarea{
       width:90%;font-size:small;
       height:10cm;
}

