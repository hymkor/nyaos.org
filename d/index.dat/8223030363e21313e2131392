と思ったが、
http://hp.vector.co.jp/authors/VA009797/warp/ell.html#rmclone{rmclone }の詳しい仕様を忘れたので、
引数で渡したディレクトリ以下で、重複してそうなファイルを表示するだけ：

8<
#!/usr/bin/env python

import os
import sys

list = {}
for root in sys.argv:
    for dirpath,dirnames,filenames in os.walk(root):
        for fn in filenames:
            fullpath = os.path.join( dirpath , fn )
            try:
                size = os.path.getsize( fullpath )
            except OSError:
                continue
            t = list.get( (fn,size) , [])
            t.append( fullpath )
            list[ fn,size ] = t

for fn,size in list :
    val = list[fn,size]
    if len(val) <= 1 :
        continue
    print "### %8d %2d %s ###" % \
        (size,len(val),fn)
    print "\n".join(val)
    print ""
