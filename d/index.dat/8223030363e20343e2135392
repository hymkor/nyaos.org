ということで「sort|uniq」を JScript で書いてみる
((fn 同一行をまとめるだけで、sort してねーですけど))。

8<
var stdin=WScript.Stdin;

var lines={};
while( !stdin.AtEndOfStream ){
    var line=stdin.ReadLine();
    lines[ line ] = 1;
}

for(var line in lines){
    WScript.Echo( line );
}
