$::preferences{'WebChain/2'} = [
    { name=>'webchain2username' , desc=>'WebChain/2 Username' }
];
$::inline_plugin{webchain2} = sub{
    my $username=$::config{webchain2username};
    <<HERE;
<img width="88" height="31" src="$::me?a=webchain2" usemap="#WEBCHAIN2-2" alt="WebChain/2" border="0" />
<map id="WEBCHAIN2-2" name="WEBCHAIN2-2">
<area shape="rect" coords="0,0,21,30" alt="Previous" href="http://www.serina.org/cgi-bin/webchain2/webchain.cgi?go=prev&amp;usr=${username}"/>
<area shape="rect" coords="22,0,44,30" alt="Ramdom Jump" href="http://www.serina.org/cgi-bin/webchain2/webchain.cgi?go=random&amp;usr=${username}"/>
<area shape="rect" coords="45,0,63,30" alt="WebChain/2 Home" href="http://www.serina.org/cgi-bin/webchain2/webchain.cgi?go=home&amp;usr=${username}"/>
<area shape="rect" coords="64,0,87,30" alt="Next" href="http://www.serina.org/cgi-bin/webchain2/webchain.cgi?go=next&amp;usr=${username}"/>
</map>
HERE
};
$::action_plugin{webchain2} = sub{
    my $img=pack('h*','');
    print  qq(Content-Type: image/png\r\n);
    print  qq(Content-Disposition: attachment; filename="webchain2.png"\r\n);
    printf qq(Content-Length: %d\r\n),length($img);
    print  "\r\n";
    print $img;
    exit(0);
};

