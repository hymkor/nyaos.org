use Encode;
use Socket;
use strict;
use warnings;

$::action_plugin{tb} = sub{
    eval{
        my $url  =$::form{url} or die("Parameter URL not found.");
        my $page =$::form{p}   or die("Parameter P   not found.");
        my $fname=&::title2fname($page,"trackback.txt");
        utime( time() , time() , &::title2fname($page) ) > 0
            or die("unable to comment to unexistant page.");
        open(FP,">>${fname}") or die("Can not open $fname for append");
            my @tm=localtime();
            my $text = join("\t",map( &::yen($_) 
                        , sprintf("%04d/%02d/%02d %02d:%02d:%02d"
                            , 1900+$tm[5],1+$tm[4],@tm[3,2,1,0])
                        , $url 
                        , $::form{title}     || $url 
                        , $::form{blog_name} || ""
                        , $::form{excerpt}   || "" ) );
            if( $::form{charset} =~ /s(hift)?[-_]?jis/i ){
                $text = Encode::decode('shiftjis',$text);
            }elsif( $::form{charset} =~ /euc[_-]?jp/i ){
                $text = Encode::decode('euc-jp',$text);
            }else{
                $text = Encode::decode('utf8',$text);
            }
            $text = substr($text,0,256) if length($text)>256;
            print FP Encode::encode('euc-jp',$text),"\r\n";
        close(FP);
    };
    if( $@ ){
        my $message=&::enc($@);
        print <<HERE;
Content-Type: text/xml

<?xml version="1.0" encoding="iso-8859-1"?>
<response>
<error>1</error>
<message>${message}</message>
</response>
HERE
    }else{
        print <<HERE;
Content-Type: text/xml

<?xml version="1.0" encoding="iso-8859-1"?>
<response>
<error>0</error>
</response>
HERE
    }
    exit(0);
};

$::inline_plugin{trackback} = sub {
    my $list=&::read_object($::form{p},'trackback.txt');
    if( $list ){
        $list = '<dl>' . join("",
            map{
                my ($time,$url,$title,$blog_name,$excerpt)=split(/\t/,$_);
                sprintf('<dt><a href="%s">%s %s</a>(%s)</dt><dd>%s</dd>'
                        , &::enc($url) , &::enc($title) , &::enc($blog_name)
                        , &::enc($time) , &::enc(&::deyen($excerpt)) );
            } split(/\r?\n/,$list)
        ) . '</dl>';
    }
    local $::me='http://'.$ENV{'HTTP_HOST'}.$ENV{'SCRIPT_NAME'};
    my $url=&::myurl( { a=>'tb' , p=>$::form{p} } );
    sprintf('%s<form>Trackback URL: <input type="text" value="%s" size="%d" readonly="readonly" style="font-family:monospace;font-size:small" onClick="this.select();" /></form>'
            , $list
            , $url
            , length($url) );
};

