$::action_plugin{'Send Trackback'} = sub {
    my $trackurl=$::form{trackurl}  or die("Trackback URL not found");
    $::form{password} = $::form{gassword};
    &::ninsho();

    if( $trackurl !~ m|^http://([^/]+)| ){
        die('Invalid URL');
    }
    my $host     = $1;
    my $path     = $';
    my $ip       = Socket::inet_aton($host) or die("$host not found.");
    my $port     = getservbyname('http', 'tcp');
    my $sockaddr = Socket::pack_sockaddr_in($port, $ip);
    socket(HTTP, Socket::PF_INET, Socket::SOCK_STREAM, 0) 
        or die("socket error.\n");
    connect(HTTP, $sockaddr);
    binmode(HTTP);
    my $output=select(HTTP); $| = 1; select($output);

    my $blog_name=$::config{sitename};
    my $page_name=$::form{p};
    my $excerpt  =$::form{excerpt};
    Encode::from_to($blog_name,'euc-jp','utf8');
    Encode::from_to($page_name,'euc-jp','utf8');
    Encode::from_to($excerpt  ,'euc-jp','utf8');

    my $myurl=sprintf('http://%s%s?p=%s' 
                , $ENV{'HTTP_HOST'}
                , $ENV{'SCRIPT_NAME'}
                , &::percent($page_name) );

    my $body=sprintf('url=%s&charset=utf-8&title=%s&excerpt=%s&blog_name=%s'
        , &::percent( $myurl )
        , &::percent( $page_name )
        , &::percent( $excerpt )
        , &::percent( $blog_name )
    );

    print  HTTP "POST $path HTTP/1.1\n";
    print  HTTP "Host: $host\n";
    printf HTTP "Content-Length: %d\n",length($body);
    print  HTTP "Content-Type: application/x-www-form-urlencoded; charset=utf-8\n";
    print  HTTP "Connection: close\n";
    print  HTTP "\n";
    print  HTTP $body;

    &::puts('Content-type: text/html; charset=utf-8','');
    &::puts('<html><head><title>Trackback Result</title></head><body>');
    &::puts('<h1>Trackback Result</h1>');
    &::putenc('<p>From <a href="%s">%s</a> to %s</p><p>' , $myurl , $myurl , $trackurl);
    while( <HTTP> ){
        &::puts( &::enc($_).'<br>' );
    }
    &::puts('</p></body></html>'); 
    close(HTTP);
};

1;
