SET SERVEROUTPUT ON SIZE 100000;
DECLARE
    TYPE T_FURUI IS TABLE OF BOOLEAN INDEX BY PLS_INTEGER;
    A_FURUI T_FURUI ;
    I       PLS_INTEGER;
    J       PLS_INTEGER;
    IMAX CONSTANT PLS_INTEGER := 100;
BEGIN
    FOR I IN 2..IMAX LOOP
        IF NOT A_FURUI.EXISTS(I) THEN
            DBMS_OUTPUT.PUT(TO_CHAR(I) || ' ');
            J := I+I;
            WHILE J <= IMAX LOOP
                A_FURUI(J) := TRUE;
                J := J + I ;
            END LOOP;
        END IF;
    END LOOP;
    DBMS_OUTPUT.NEW_LINE;
END;
