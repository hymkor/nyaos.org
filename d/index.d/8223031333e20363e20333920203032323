import "C"
import "fmt"

func main(){
	handle := C.GetStdHandle( C.STD_INPUT_HANDLE )
	fmt.Printf("C.STD_INPUT_HANDLE=%d\n",handle)

	var buffer [10]C.struct__INPUT_RECORD
	var numberOfEventsRead C.DWORD

	for {
		result := C.ReadConsoleInput( handle ,
							&buffer[0] ,
							C.DWORD(len(buffer)) ,
							&numberOfEventsRead )

		fmt.Printf("result=%d\n",result)
		fmt.Printf("eventRead=%d\n",numberOfEventsRead)
		for i:=C.DWORD(0) ; i< numberOfEventsRead ; i++ {
			if buffer[i].EventType == C.KEY_EVENT &&
			   (C.getKeyEvent(&buffer[i]).bKeyDown) != C.FALSE {
				fmt.Printf("[%d]\n", C.getAsciiChar(&buffer[i]))
				return
			}
		}
	}
}
