<<[VC++] DebugOutput改良>>

* >>{(2013.01.08)#p2}{MHI 5.0 - $ OutputDebugString を何回も書くのがうざい}

数値が出せなかったので対応。さくっと、stdafx.h に貼り付けるだけ

8<
class DebugStream {
	void (__stdcall *func)(LPCTSTR s);
public:
	DebugStream( void (__stdcall *f)(LPCTSTR) ) : func(f){}
	DebugStream &operator << ( LPCTSTR s )
	{  (*func)(s); return *this; }
	DebugStream &operator << ( int n )
	{  CString tmp;tmp.Format(_T("%d"),n); (*func)(tmp); return *this; }
};
static DebugStream DebugOutput(OutputDebugString);
>8

今まで

8<
CString tmp;
tmp.Format(_T("%d\n"),値);
OutputDebugString(tmp);
>8

とかしてたのが

8<
DebugOutput << 値 << _T("\n");
>8

になった。なんで今までしてなかったんだろう。

