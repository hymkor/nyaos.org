<<<調査用スクリプト>>>

8<
local month = {
    Jan="01", Feb="02" , Mar="03" , Apr="04" , May="05" ,Jun="06",
    Jul="07", Aug="08" , Sep="09" , Oct="10" , Nov="11", Dec="12"
}

local logfd = assert(io.popen('hg log --stat','r'))
local dt
local codes={}
local commit={}
for line in logfd:lines() do
    -- print(line)
    local mon,year = string.match(line,'^日付:%s+%w+%s+(%w+)%s+%d+%s+%S+%s+(%d+)')
    if mon and year then
        dt = year .. '.' .. (month[mon] or mon)
    else
        local m = string.match(line,'^%s*%d+%s*ファイル変更、%s*追加%s*(%d+)%s*行')
        if dt and m then
            codes[ dt ] = (codes[ dt ] or 0) + m
            commit[ dt ] = (commit[ dt] or 0) + 1
        end
    end
end
logfd:close()
for key,val in pairs(codes) do
    print(string.format('|| %s | %s | %s\n',key,val,commit[key]))
end
