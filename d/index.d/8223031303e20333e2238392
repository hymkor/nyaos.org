けど、仮想関数の参照が出てこないので、あきらめた。

8<
#!/usr/bin/python

import sys
import os

referer = {}

for arg1 in sys.argv[1:] :
    nm = os.popen("nm --demangle "+arg1,"r")
    for line in nm :
        p = line.split()
        if len(p) < 2:
            continue
        mark = p[-2]
        name = p[-1]
        if mark == 'U' :
            referer[ name ] = referer.get(name,0) + 1
        elif (mark=='t' or mark=='T') and name not in referer :
            referer[ name ] = 0
    nm.close()

for name,count in referer.iteritems():
    if count == 0 :
        print( name )
