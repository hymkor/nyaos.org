#!/usr/bin/python2

class Klass:
    def __init__(self,value):
        self.member1   = value
        self._member2  = value
        self.__member3 = value

instance = Klass("ahaha")
print "member1=",instance.member1
print "member2=",instance._member2
print "member3=",instance.__member3
