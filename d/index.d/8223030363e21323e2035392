#!/usr/bin/python

import re

def words(s,pattern=r"\w+"):
    hash = {}
    for m in re.finditer(pattern,s):
        w = m.group(0)
        hash[w] = hash.get(w,0) + 1
    return hash

s = """We wish you a Merry Christmas,
We wish you a Merry Christmas,
We wish you a Merry Christmas,
and A Happy New Year!
"""

for key,value in words(s).iteritems():
    print "%s => %s" % (key,value)
