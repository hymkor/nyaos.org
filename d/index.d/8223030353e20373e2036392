#!/usr/bin/gawk -f

BEGIN{
    prefix=""
    for(i in ARGV){
	if( ARGV((lb))i((rb)) ~ /^\// ){
	    ARGW((lb))i((rb)) = "/" prefix ARGV((lb))i((rb))
	}else{
	    ARGW((lb))i((rb)) = prefix ARGV((lb))i((rb))
	}
	prefix = "./" prefix
    }

    for(;;){
	succ = 0;
	line = "";
	for( i = 1 ; i in ARGW ; ++i ){
	    if( status((lb))i((rb)) != "NG" && getline < ARGW((lb))i((rb)) ){
		line = line "\t" $0
		succ++;
	    }else{
		line = line "\t"
		status((lb))i((rb)) = "NG";
	    }
	}
	if( succ <= 0 ){ break; }
	print substr(line,2);
    }
}
