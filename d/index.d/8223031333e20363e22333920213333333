package main

import "fmt"
import "os"
import "os/exec"
//import "strings"
//import "reflect"

import "bitbucket.org/zetamatta/conio"

func main(){
        wd,_ := os.Getwd()
        for{
                fmt.Printf("%s\n$ ",wd)
                line := conio.ReadLine()
                if line == "exit" {
                        break
                }
                //argv := strings.Split(line," ")
                //if len(argv) <= 0 {
                //      continue
                //}
                cmd := exec.Command("cmd.exe","/c",line)
                cmd.Stdin  = os.Stdin
                cmd.Stdout = os.Stdout
                cmd.Stderr = os.Stderr
                cmd.Run()
        }
}
