!!! ((title できる！日本語入力 #golang))

testing パッケージを使うと、標準入力がhttps://twitter.com/mattn_jp/status/341690835873718272{リダイレクトされてしまうらしい}ので、普通にテスト用の main を作ってテストしてみるようにした。
だいたい想定どおり動くようになった。よしよし。

ソースはそのまま TEXTAREA へコピペすると、4桁想定のタブがブラウザ上で8桁に展開されてしまってみっともないので、
expand コマンドで4桁にコンバートしてみた。

ライブラリ本体：

8<
$ expand -4 conio\getch.go
package conio

/*
#include <windows.h>
KEY_EVENT_RECORD* getKeyEvent(struct _INPUT_RECORD *input) {
    return &(input->Event.KeyEvent);
}
char getAsciiChar(struct _INPUT_RECORD *input) {
    return input->Event.KeyEvent.uChar.AsciiChar;
}
WCHAR getUnicodeChar(struct _INPUT_RECORD *input) {
    return input->Event.KeyEvent.uChar.UnicodeChar;
}
*/
import "C"

var ch chan C.WCHAR = make(chan C.WCHAR)

func init(){
    go func(ch chan C.WCHAR){
        hConin := C.GetStdHandle( C.STD_INPUT_HANDLE )
        for{
            var numberOfEventsRead C.DWORD
            var events [10]C.struct__INPUT_RECORD
            var orgConMode C.DWORD

            C.GetConsoleMode(hConin,&orgConMode)
            C.SetConsoleMode(hConin,0)
            C.ReadConsoleInputW(hConin ,
                                &events[0] ,
                                C.DWORD(len(events)) ,
                                &numberOfEventsRead )
            C.SetConsoleMode(hConin,orgConMode)
            for i:=C.DWORD(0) ; i < numberOfEventsRead ; i++ {
                if events[i].EventType == C.KEY_EVENT && C.getKeyEvent(&events[i]).bKeyDown != C.FALSE {
                    ch <- C.getUnicodeChar( &events[i] )
                }
            }
        }
    }(ch)
}

func GetchW() uint16 {
    return uint16(<-ch)
}
>8

チャネルを使うと、下手なバッファリングとかをしなくていいのが、たすかる。

テストプログラム：

8<
[C:src]
$ expand -4 conio_tst\conio_tst.go
package main
import "../conio"
import "fmt"
import "unicode/utf16"

func main(){
    fmt.Println("Start!")
    for{
        ch := conio.GetchW()
        if ch == 3 {
            return
        }
        if ch == 0 {
            continue
        }
        cp := utf16.Decode([]uint16{ch})
        fmt.Printf("%c[%04x]",cp[0],ch)
    }
}
[C:src]
