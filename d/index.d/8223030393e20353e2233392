local conn=olua.new("HR","HR","XE");

function select(conn)
    for rows in conn:exec("select * from foo") do
        print( ("%d: %s %04d/%02d/%02d %02d:%02d:%02d")
                :format(rows.SERIAL , rows.USAGE , 
                        rows.STAMP.year , rows.STAMP.month , rows.STAMP.day ,
                        rows.STAMP.hour , rows.STAMP.min   , rows.STAMP.sec ) )
    end
end

function insert(conn)
    local list = {
        "dog" , "cat" , "lion" , "tiger" , "apple" , "wood"
    }
    local count=0
    for row in conn:exec("select count(*) from foo") do
        count = row[1]
    end
    for i,animal in ipairs(list) do
        conn:exec("insert into foo values(:1,:2,sysdate)" , i+count , animal )
    end
end

insert(conn)
print("--- before rollback ---")
select(conn)
conn:rollback()
print("--- after rollback ---")
select(conn)

print("\n=== retry insert ===")
insert(conn)
insert(conn)
select(conn)
print("--- before commit ---")
conn:commit()
print("--- after commit ---")
select(conn)
