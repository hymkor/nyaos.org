#!/usr/local/bin/python3.0

import sys

class ostream(object) :
    def __init__(self,fd=sys.stdout):
        self.sep = ""
        self.fd = fd

    def __lshift__(self,data):
        if hasattr(data,'__call__'):
            data(self)
        else:
            print( self.sep , data , file=self.fd , end="" , sep="" )
            self.sep = " "
        return self

    def endl(self):
        self.sep = ""
        print()

cout = ostream()
endl = ostream.endl

