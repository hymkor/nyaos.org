using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;

namespace Summon
{
    class Program
    {
        static string purename(string uri)
        {
            uri = uri.TrimEnd(new char[] { '/' });
            int lastroot = uri.LastIndexOf('/');
            return uri.Substring(lastroot + 1);
        }
        static void wget(string uri,string fname)
        {
            var browser = new System.Net.WebClient();
            browser.DownloadFile(uri, fname);
            browser.Dispose();
        }
        static string search_latest(string index_uri_, string pattern_)
        {
            var index_uri = new Uri(index_uri_);
            var pattern = new System.Text.RegularExpressions.Regex(pattern_);

            var browser = new System.Net.WebClient();
            var html = browser.DownloadString(index_uri_);
            browser.Dispose();

            var mc = System.Text.RegularExpressions.Regex.Matches(
                html, "<a[^>]+href=\"([^\"]+)\"");

            string hit_uri = "";
            foreach (System.Text.RegularExpressions.Match m1 in mc)
            {
                string g1 = m1.Groups[1].Value;
                string uri = new Uri(index_uri, g1.Replace("&amp;","&")).AbsoluteUri;
                if (pattern.IsMatch(uri))
                {
                    if (string.Compare(uri, hit_uri) > 0)
                    {
                        hit_uri = uri;
                    }
                }
            }
            return hit_uri;
        }
        static string where_to_redirect(string uri)
        {
            var browser = new System.Net.WebClient();
            string html = browser.DownloadString(uri);
            browser.Dispose();
            var mc = System.Text.RegularExpressions.Regex.Matches(html, "<meta[^>]*url=([^\"> ]+)\"",
                System.Text.RegularExpressions.RegexOptions.Singleline |
                System.Text.RegularExpressions.RegexOptions.IgnoreCase );
            foreach(System.Text.RegularExpressions.Match m1 in mc)
            {
                return new Uri(new Uri(uri),m1.Groups[1].Value.Replace("&amp;","&")).AbsoluteUri;
            }
            return null;
        }

        static void Main(string[] args)
        {
            bool redirect = false;
            int argsbase = 0;

            if ( args.Length > 0 && args[0] == "-r")
            {
                redirect = true;
                argsbase = 1;
            }
            
            if (args.Length-argsbase < 2)
            {
                Console.Write("Usage: Summon.exe [-r] INDEX-URL PATTERN\n");
                return;
            }

            Console.WriteLine("Searching " + args[argsbase]);
            string target_uri = search_latest(args[argsbase], args[argsbase+1]);
            string fname = purename(target_uri);
            Console.WriteLine("Download: " + target_uri);
            if (redirect)
            {
                target_uri = where_to_redirect(target_uri);
                if (target_uri == null)
                {
                    Console.WriteLine("redirected url not found.");
                    return;
                }
                Console.WriteLine("Redirect to " + target_uri);
            }
            
            Console.Write("Save as " + fname);
            wget(target_uri,fname);
            Console.WriteLine(" done");
            return;
        }
    }
}
