        function nyaos.keyhook.date(t)
            if t.key == nyaos.key.F11 then
                return os.date('%Y%m%d')
            end
        end
        function nyaos.keyhook.time(t)
            if t.key == nyaos.key.F12 then
                return os.date('%H%M%S')
            end
        end
        function nyaos.command.luaprint(...)
            local argv={...}
            for i,e in pairs(argv) do
                print(i,e)
            end
        end

        --[[
        function nyaos.filter.env(cmdline)
            return string.gsub(cmdline,'${([^/}]+)/([^/}]+)/([^}]*)}',
                function(env,fromstr,tostr)
                    return string.gsub(os.getenv(env),fromstr,tostr)
                end
            )
        end
        function nyaos.filter.filter_z(cmdline)
            print('Z:'..cmdline)
            return cmdline
        end
        function nyaos.filter.filter_a(cmdline)
            print('A:'..cmdline)
            return '  '..cmdline
        end
        function nyaos.filter.filter_m(cmdline)
            print('M:'..cmdline)
            return cmdline
        end
        function nyaos.filter(cmdline)
            print('trace: '..cmdline)
            return cmdline
        end
        -- ]]--

        function nyaos.command.cat(...)
            local argv={...}
            local option={}
            if next(argv) then
                for i,fname in pairs(argv) do
                    if fname:sub(1,1)=='-' then
                        for j=2,fname:len() do
                            option[ fname:sub(j,j) ] = 1
                        end
                    else
                        local rc,msg=pcall( function()
                            for line in io.lines(fname) do
                                if option.n then
                                    print(('%%6d  %%s'):format(option.n,line))
                                    option.n = option.n + 1
                                else
                                    print(line)
                                end
                            end
                        end)
                        if not rc then
                            print( fname..': No such file or directory(lua)' )
                        end
                    end
                end
            else
                for line in io.lines() do
                    print(line)
                end
            end
        end

        --[[
        function nyaos.filter.auto_cd(argv)
            local dir=argv:gsub('\034',''):gsub('\\$','')
            local stat=nyaos.stat(dir)
            if stat and stat.directory then
                return 'cd '..argv
            end
            return argv
        end
        ]]--
