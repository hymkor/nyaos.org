<<[Lua] 「use strict;」相当のことが出来た!>>

8<
$ cat strict.lua
local strict={
    __newindex = function(t,i,v)
        error("** you can not assign global variable '"..i.."' **")
    end
}
setmetatable(_G,strict)

--- Test ---

local foo="use local variable:OK"
print(foo)

bar="use global variable"
print(bar)

$ lua strict.lua
