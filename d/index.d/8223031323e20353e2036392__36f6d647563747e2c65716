local obj=nyaos.create_object("Scripting.FileSystemObject")
local path=obj:GetAbsolutePathName("comtest.lua")
print(path)
local file,err=obj:GetFile(path)
if not file then
    print("obj:GetFile:",err)
    os.exit()
end
local fp,err=file:OpenAsTextStream()
if not fp then
    print("file:OpenAsTextStream:",err)
    os.exit()
end
while not fp.AtEndOfStream do
    local s,err=fp:ReadLine()
    if not s then
        print("fp:ReadLine:",err)
        os.exit()
    else
        print(s)
    end
end
