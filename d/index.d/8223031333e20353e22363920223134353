!!! ((title #golang で引数のファイルの各行を全部ひっぱってくるライブラリを作った))

俺にとっては定番の奴。Perl の <> 、Python の ``fileinput.input``、Ruby の ``ARGF`` に相当する奴。
でも、こういうのって、普通、標準にありそうなんだけどなぁ。

'''./eachline/eachline.go''' :

8<
package eachline

import (
	"bufio"
	"os"
)

func EachLine(filepath string) chan string {
	ch := make(chan string)
	go func(ch chan string){
		defer close(ch)
		fd , err := os.Open(filepath)
		if err != nil {
			return
		}
		defer fd.Close()
		reader := bufio.NewReader(fd)
		for{
			line,err := reader.ReadString('\n')
			if err != nil {
				return
			}
			ch <- line
		}
	}(ch)
	return ch
}

func EachArgsLine() chan string {
	ch := make(chan string)
	go func(ch chan string){
		defer close(ch)
		if len(os.Args) >= 2 {
			for i:=1;i<len(os.Args);i++ {
				for line := range(EachLine(os.Args[i])) {
					ch <- line
				}
			}
		}else{
			reader := bufio.NewReader(os.Stdin)
			for{
				line,err := reader.ReadString('\n')
				if err != nil {
					return
				}
				ch <- line
			}
		}
	}(ch)
	return ch
}
>8

'''./main.go'''

8<
package main

import (
	"./eachline"
	"fmt"
)

func main(){
	for line := range(eachline.EachArgsLine()) {
		fmt.Print(line)
	}
}
>8

