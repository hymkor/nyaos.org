>> イテレータ関数！ <<

どうやら、この言語、思ったよりも奥が深そうな勢いだぜ。
(紹介しだすとキリがないので、この辺にしておく)

<<[Lua] ARGF/fileinput 的なものを書いてみた>>

8<
#!/usr/local/bin/lua

function ARGF()
    local ARGINDEX=1
    local NR=0
    local iter,status,pointer = io.lines(arg[ARGINDEX])
    return function()
        while true do
            line = iter(status,pointer)
            if line ~= nil then
                NR = NR + 1
                return line,arg[ARGINDEX],NR
            end
            ARGINDEX = ARGINDEX + 1
            NR = 0
            if ARGINDEX > #arg then
                return nil,nil,nil
            end
            iter,status,pointer = io.lines(arg[ARGINDEX])
        end
    end
end

for line in ARGF() do
    print(line)
end
>8

