8<
#include <windows.h>
#define DEBUG

#ifdef DEBUG
#  include <stdio.h>
#endif

BSTR c2b(const char *s)
{
    size_t csize=strlen(s);
    size_t wsize=MultiByteToWideChar(CP_ACP,MB_PRECOMPOSED,s,csize,NULL,0);
    BSTR w=SysAllocStringLen(NULL,wsize );
    if( w == NULL ){
#ifdef DEBUG
        puts("memory allocation error");
#endif
        return NULL;
    }
    MultiByteToWideChar(CP_ACP,0,s,csize,w,wsize);
    return w;
}

class ActiveXObject {
    static int instance_count;
    IDispatch *pApplication;
public:
    ActiveXObject(const char *name);
    ~ActiveXObject();
    int invoke(const char *name,
            WORD wflags ,
            VARIANT *argv ,
            int argc ,
            VARIANT *result );

    operator const void*() const
    { return pApplication != NULL ? this : 0; }
    int operator !() const
    { return pApplication == NULL; }
};

int ActiveXObject::instance_count = 0;

ActiveXObject::~ActiveXObject()
{
    if( pApplication != NULL )
        pApplication->Release();
    if( --instance_count <= 0 )
        CoUninitialize();
}

ActiveXObject::ActiveXObject(const char *name)
{
    CLSID clsid;
    HRESULT hr;

    if( instance_count++ <= 0 )
        CoInitialize(NULL);

    /* クラス名をユニコード化 */
    BSTR wname=c2b(name);
    if( wname == NULL ){
#ifdef DEBUG
        puts("Error: c2b");
#endif
        goto exit;
    }

    /* クラスID取得 */
    hr = CLSIDFromProgID( wname , &clsid );
    if( FAILED(hr) ){
#ifdef DEBUG
        puts("Error: CLSIDFromProgID");
#endif
        goto exit;
    }

    /* インスタンス作成 */
    hr = CoCreateInstance(
            clsid ,
            NULL ,
            CLSCTX_INPROC_SERVER , /* or CLSCTX_LOCAL_SERVER , */
            IID_IDispatch ,
            (void**)&this->pApplication );
    if( FAILED(hr) ){
#ifdef DEBUG
        puts("Error: CoCreateInstance");
#endif
        goto exit;
    }
    SysFreeString( wname );
    return;
exit:
    pApplication = NULL;
    free( wname );
}

int ActiveXObject::invoke(
        const char *name,
        WORD wflags ,
        VARIANT *argv ,
        int argc ,
        VARIANT *result )
{
    HRESULT hr;
    DISPID dispid;
    DISPID dispid_name;
    DISPPARAMS disp_params;
    UINT puArgerr = 0;
    EXCEPINFO excepinfo;

    BSTR wname=c2b( name );

    hr = this->pApplication->GetIDsOfNames(
            IID_NULL , /* 将来のための予約フィールド */
            &wname ,
            1 ,
            LOCALE_USER_DEFAULT , 
            &dispid );
    if( FAILED(hr) ){
#ifdef DEBUG
        puts("Error: GetIDsOfNames");
#endif
        goto errpt;
    }
    
    disp_params.cArgs  = argc ;
    disp_params.rgvarg = argv ;

    if( wflags & DISPATCH_PROPERTYPUT ){
        disp_params.cNamedArgs = 1;
        disp_params.rgdispidNamedArgs = &dispid_name;
    }else{
        disp_params.cNamedArgs = 0;
        disp_params.rgdispidNamedArgs = NULL;
    }

    hr = this->pApplication->Invoke(
            dispid ,
            IID_NULL ,
            LOCALE_SYSTEM_DEFAULT ,
            wflags ,
            &disp_params ,
            result ,
            &excepinfo ,
            &puArgerr );
    if( FAILED(hr) ){
#ifdef DEBUG
        puts("Error: Invoke");
        printf("Error=[%0X]\n",GetLastError());
#endif
        goto errpt;
    }

    SysFreeString(wname);
    return 0;
errpt:
    SysFreeString(wname);
    return -1;
}

