Lua でやってみた。

8<
$ cat a.lua
local fizzbuzz = {}
for i=1,30 do
    if i % 3 == 0 then fizzbuzz[i] = (fizzbuzz[i]or"").."Fizz" end
    if i % 5 == 0 then fizzbuzz[i] = (fizzbuzz[i]or"").."Buzz" end
end
print(#fizzbuzz)
for i,e in pairs(fizzbuzz) do
    print(e)
end
>8
