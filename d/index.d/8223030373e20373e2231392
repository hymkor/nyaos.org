#!/usr/bin/env python
# -*- coding: mbcs -*-

import re
import xml.parsers.expat

class dict2object:
    def __init__(self,attr):
        for key,val in attr.iteritems():
            setattr(self,key.replace("-","_").lower() , val )
    def __contains__(self,key):
        return key in self.__dict__

class dict2node(dict2object):
    def __init__(self,attr):
        self._list = []
        dict2object.__init__(self,attr)
    def append(self,value):
        self._list.append( value )
    def __getitem__(self,n):
        return self._list[n]
    def __iter__(self):
        return self._list.__iter__()

class SIObject:
    def __init__(self):
        self.id         = {}
        self.entities   = {}
        self.model      = {}
        self._cur_entity = None
        self._cur_model  = None
        self._cur_index  = None

    def __call__(self,name,attrs=None):
        if attrs : ### Start ###
            if name == "ENTITY" :
                entity = dict2node(attrs)
            if self._cur_model :
                target = self.id[ entity.id ]
                self._cur_model[ target.p_name ] = target
            elif "p_name" in entity :
                self._cur_entity = self.id[ entity.id ] = \
                self.entities[entity.p_name] = entity
                self._cur_entity.index = []
            elif name == "ATTR" and self._cur_entity :
                attr = dict2object(attrs)
                if re.match("TIMESTAMP\(\d+\)",attr.datatype ):
                    attr.datatype = "TIMESTAMP"
                if attr.scale != "0":
                    attr.dim = "%s,%s" % (attr.length,attr.scale)
                else:
                    attr.dim = attr.length
                self._cur_entity.append( attr )
            elif name == "INDEX" and self._cur_entity :
                self._cur_index = dict2node(attrs)
                self._cur_entity.index.append( self._cur_index )
                if attrs["I-TYPE"] == "0" :
                    self._cur_entity.primary_index = self._cur_index
            elif name == "COLUMN" and self._cur_index :
                self._cur_index.append( dict2object(attrs) )
            elif name == "MODELVIEW" :
                self._cur_model = self.model[ attrs["L-NAME"] ] = {}
            else : ### End ###
                if name == "ENTITY" :
                   self._cur_entity = None
                elif name == "INDEX" :
                   self._cur_index = None
                elif name == "MODELVIEW" :
                   self._cur_model = None
    def loadFile(self,fd) :
        xmlparser = xml.parsers.expat.ParserCreate("UTF-8")
        xmlparser.StartElementHandler = xmlparser.EndElementHandler = self
        xmlparser.ParseFile( fd )
    def __iter__(self):
        return self.entities.itervalues()

if __name__ == "__main__":
