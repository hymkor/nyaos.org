C++ で例外を参照で補足していいか、不安があったので、実験してみた。

<< ソース>>

<pre>
    #include <iostream>
    #include <string>
    #include <exception>
    
    using namespace std;
    
    class Sample : public exception {
	string name;
    public:
	Sample(const string &n){
	    name = n;
	    cerr << "デフォルトコンストラクタ for " << name << endl;
	}
	Sample( const Sample &y ){
	    name = y.name + '\'';
	    cerr << "コピーコンストラクタ for " << name << endl;
	}
	const string &who() const { return name; }
	~Sample(){
	    cerr << "デストラクタ for " << name << endl;
	}
    };
    
    void sub()
    {
	Sample x("sub::local");
	cerr << "--- サブルーチン内---\n";
	throw Sample("sub::temp");
    }
    
    void sub1( Sample s )
    {
	cerr << "--- サブルーチン内---\n";
	cerr << "仮引数の実体 = " << s.who() << endl;
    }
    
    void sub2( const Sample &s )
    {
	cerr << "--- サブルーチン内---\n";
	cerr << "仮引数の実体 = " << s.who() << endl;
    }
    
    int main()
    {
	cerr << "\n● 実体で例外を受け取る場合\n";
	try{
	    sub();
	}catch( Sample e ){
	    cerr << "--- catch ブロック---\n";
	    cerr << "仮引数の実体 = #" << e.who() << endl;
	}
	cerr << "\n● 参照で例外を受け取る場合\n";
	try{
	    sub();
	}catch( const Sample &e ){
	    cerr << "--- catch ブロック---\n";
	    cerr << "仮引数の実体 = #" << e.who() << endl;
	}
    
	Sample s("main::local");
	cerr << "\n● 実体で引数を渡す場合(通常オブジェクト)\n";
	sub1( s );
    
	cerr << "\n● 実体で引数を渡す場合(一時オブジェクト)\n";
	sub1( Sample("main::temp1") );
    
	cerr << "\n● 参照で引数を渡す場合(通常オブジェクト)\n";
	sub2( s );
    
	cerr << "\n● 参照で引数を渡す場合(一時オブジェクト)\n";
	sub2( Sample("main::temp2") );
	
	cerr << "\n● 終了\n";
	return 0;
    }
</pre>

