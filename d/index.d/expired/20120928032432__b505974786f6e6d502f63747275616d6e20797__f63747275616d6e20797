import sys

class ostream(object) :
    def __init__(self,fd=sys.stdout):
        self.sep = ""
        self.fd = fd

    def __lshift__(self,data):
        if hasattr(data,'__call__'):
            data(self)
        else:
            if self.sep :
                self.fd.write( self.sep )
            self.fd.write( str(data) )
            self.sep = " "
        return self

    def endl(self):
        self.sep = ""
        self.fd.write("\n")

cout = ostream()
cerr = ostream(sys.stderr)
endl = ostream.endl

