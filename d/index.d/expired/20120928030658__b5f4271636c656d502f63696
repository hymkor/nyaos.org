    /* エラーオブジェクト */
    class ppoci_error : public exception {
	sword  code_;
	std::string detail_;
    public:
	ppoci_error( const ppoci_error &y )
	    : code_(y.code_) ,detail_(y.detail_){}
	ppoci_error(sword code , const char *what) 
	    : code_(code) , detail_(what) , exception(){}
	ppoci_error(sword code , const std::string &what) 
	    : code_(code) , detail_(what) , exception(){}
	ppoci_error(sword code , const std::string &what,OCIError *errhp);
	
	sword code() const { return code_; }
	const std::string &detail() const { return detail_; }
	const char *code_name() const;
    };

    /* 接続オブジェクト */
    class connection_t {
	OCIEnv    *envhp_;
	OCIError  *errhp_;
	OCISvcCtx *svchp_;
    public:
	OCIEnv    *envhp() const { return envhp_; }
	OCIError  *errhp() const { return errhp_; }
	OCISvcCtx *svchp() const { return svchp_; }
	connection_t() : envhp_(0) , errhp_(0) , svchp_(0){}

	void open_error_handle();
	void close_error_handle();
	void envinit();
	void connect( const std::string &name ,
		      const std::string &pwd ,
		      const std::string &db );
	void disconnect();
    };

    class statement_t {
	connection_t &connection_;
	std::string   sql_;
	OCIStmt      *handle_;
	std::vector<OCIBind*>   binds_;
	std::vector<OCIDefine*> defines_;
    protected:
	connection_t &connection(){ return connection_; }
	OCIStmt      *handle(){ return handle_; }
    public:
	statement_t( connection_t &c , const string &sql ) 
	    : connection_(c) , sql_(sql) , handle_(0) , binds_(30){}

	void open_handle();
	void prepare();
	void bind( const char *name , char *buffer , size_t size );
	void into( char *buffer , size_t size );
	void execute();
	bool fetch();
	void close_handle();
    };
