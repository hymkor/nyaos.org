:``type.go`` :

8<
package main

import (
	"bufio"
	"fmt"
	"os"
)

func main(){
	if len(os.Args) <= 1 {
		fmt.Printf("Usage: %s FILENAME\n",os.Args[0])
		return
	}
	for i:=1 ; i < len(os.Args) ; i++ {
		fd,err := os.Open(os.Args[1])
		if err != nil {
			fmt.Printf("%s: Can not open\n",os.Args[1])
			return
		}

		reader := bufio.NewReader(fd)
		for{
			line , err := reader.ReadString('\n')
			if err != nil {
				break
			}
			fmt.Print(line)
		}
		fd.close()
	}
}
>8

