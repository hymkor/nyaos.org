<<[NYAOS] 帰ってきた多次元配列>>

えーと、4月15日の変更で、Lua の多重テーブルを COM へ多次元配列として渡せるようになりましたが、
今日は逆に COM の多次元配列を逆に Lua の多重テーブルとして受け取れるようになりました。

んでもって、今まで「``nyaos -f foo.lua``」と書いていたのを
「``nyaos foo.lua``」と書けるようにしました。

参考までに書いてみたデモスクリプト。
実行すると Excel を起動して、セルにデータを書き込み、
次に(自分が書き込んだ)セルのデータを読み出します。

8<
[c:nyaos3k]
$ type excel.lua
local excel=nyaos.create_object("Excel.Application")
excel.Visible = true
local workbook = excel.Workbooks:Add()
local worksheet = workbook.Worksheets:Item(1)
worksheet:Range("A1:D4").value = {
    { "東","西","南","北" },
    { "A","B","C","D" },
    { 1,2,3,4 },
    { "W","X","Y","Z" }
}
if arg[1] then
    worksheet:Range("E1").value = arg[1]
end

function print_table(t)
    for key,val in pairs(t) do
        if type(val)=='table' then
            print_table(val)
        else
            io.write(string.format('%s(%s),',val,type(val)))
        end
    end
    io.write("\n")
end

foo = worksheet:Range("A1:C3").Value
print_table(foo)
