8<
function split(s)
    local list={}
    for fragment in string.gmatch(s,'%S+') do
        table.insert(list,fragment)
    end
    return list
end

local timeline={}
local disktype={}
local last_time=nil
for line in io.lines() do
    local cols=split(line)
    if #cols == 3 then
        table.insert( timeline , { 
            time=cols[1],
            [ cols[2] ]= cols[3]
        })
        disktype[ cols[2] ]=1
    else
        timeline[#timeline][ cols[1] ] = cols[2]
        disktype[ cols[1] ]=1
    end
end

local disklist={}
for key,val in pairs(disktype) do
    table.insert( disklist , key )
end
table.sort( disklist )

for i=1,#timeline do
    for j=1,#disklist do
        print(  timeline[i].time ..' '..
                disklist[j] ..' '..
                (timeline[i][disklist[j]] or 0)
        )
    end
end
