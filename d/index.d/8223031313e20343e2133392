8<
import fileinput

timeline = []
disktype = set()
for line in fileinput.input():
    cols = line.split()
    if len(cols) == 3 :
        timeline.append( { 'time':cols[0] , cols[1]:cols[2] } )
        disktype.add( cols[1] )
    else:
        timeline[-1][ cols[0] ] = cols[1]
        disktype.add( cols[0] )
disktype = sorted( disktype )
for t in timeline:
    for d in disktype:
        print t['time'],d,t.get(d,0)
