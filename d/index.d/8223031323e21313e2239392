<<#Lua で ShiftJIS を一文字ずつ処理>>

* http://d.hatena.ne.jp/ousttrue/20091007/1254909683{utf8バイト列を1文字ずつ処理する - 三次元日誌}

のパクリです。

8<
cp932 = {
    each_char=function(s)
        local pos=1
        return function()
            local c = string.byte(s,pos,pos)
            if not c then
                return nil
            elseif (0x81<= c and c <=0x91) 
                or (0xE0<= c and c <=0xFC) then
                pos = pos + 2
                return string.sub(s,pos-2,pos-1)
            else
                pos = pos + 1
                return string.sub(s,pos-1,pos-1)
            end
        end
    end
}

for c in cp932.each_char("あいうえおabcdefgかきくけこ") do
    print(c)
end
>8

