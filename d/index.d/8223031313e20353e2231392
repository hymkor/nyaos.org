Lua でも、Perl なみには例外処理できます。
要は引数付き大域脱出が出来ればいいのです。
Lua には明示的にエラーを発する error文と、関数内でエラーが起きても処理を止めずに該当関数だけを終了させる pcall文があるので、これで簡単な例外を実現できます。

というわけで作った、try関数：

8<
function try(block,catch)
    local success,error_info=pcall(block)
    if not success then
        if type(error_info)=='table' then
            -- catch節を呼び出す --
            return catch(error_info)
        else
            -- マジエラー --
            error(error_info,2)
        end
    end
end

function func(n)
    if n < 0 then
        error{ class="Invalid Value" }
    end
    print(n)
end

try( function()
    print("*** 例外処理の例 ***")
    func(1)
    func(0)
    func(-1)
    func(-2)
end ,
function(e)
    print("Exception occured: ".. e.class)
end
)

try( function()
    print("*** こちらはマジエラーの例 ***")
    print( non_exist_function() )
end,
function()
    print("Exception occured: ".. e.class)
end
)
>8

