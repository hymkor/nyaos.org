8<
#!/usr/bin/lua

function insert_sort(arr)
    for i=2,#arr do
        local j=i
        while j>1 and arr[j-1]>arr[j] do
            arr[j-1],arr[j] = arr[j],arr[j-1]
            j = j - 1
        end
    end

end

line = {}
for L in io.lines() do
    table.insert(line,tonumber(L))
end

insert_sort(line)
for i=1,#line do
    print(line[i])
end
