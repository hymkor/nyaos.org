#ifdef TEST

void putchw_(int k)
{
    wchar_t utf16[]={ k , 0 };
    char mbcs[10];

    int len=WideCharToMultiByte(
            CP_THREAD_ACP,0,utf16,1,mbcs,sizeof(mbcs),NULL,NULL);
    for(int i=0;i<len;i++)
        printf("%02X,",mbcs[i] & 0xFF );

    fwrite(mbcs,len,stdout);
    for(int i=0;i<len;i++)
        putc(mbcs[i],stdout);
}

int
main(int argc, char **argv)
{
  int k;
  
  for(;;) {
#ifdef BUILD_FOR_WCHAR
    k = getwch_replacement_for_msvc();
    putchw_( k );
    printf("=0x%x\n", k);
#else
    k = getch_replacement_for_msvc();
    printf("0x%x", k);
    if (k >=20 && k <= 0x7e) printf(" (%c)", k);
    printf("\n");
#endif
    if (k == -1 || k == 0x1b) break;
  }
  return 0;
}

#endif
