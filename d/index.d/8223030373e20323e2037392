#!/usr/local/bin/python

import fileinput

allset=set()
distset={}

for p in fileinput.input():
    allset.add(p)
    distset.setdefault(fileinput.filename(),set()).add(p)

dist=sorted( distset.keys() )
print " | ".join(["%-11.11s" % i for i in [""]+dist])
for p in allset:
    print "%-11.11s" % p.strip() ,
    for d in dist:
        if p in distset[d]:
            print "| include    ",
        else:
            print "| not-include",
    print
