OTRS の Hearbeat への登録
-------------------------

    OTRS のリソースマネージャーを作成する。
        # vim /usr/lib/ocf/resource.d/borderless/otrs 
----- ここから ----- ここから ----- ここから ----- ここから -----
#!/bin/sh
#
#       High-Availability OTRS control script
#
# otrs
#
# Description:  starts/stops OTRS service.
#
# Author:       Kaoru Hayama
#
# Copyright:    (c) 2011 TIS Corporation.
#                   (http://www.tis.co.jp)
#
# History:
#      2011.03.08 - First version
#      2011.04.05 - rewrite after reading ra-dev-guide.pdf
#      2011.04.26 - rewrite after reviewed by 3ware.

: ${OCF_FUNCTIONS_DIR=${OCF_ROOT}/resource.d/heartbeat}
. ${OCF_FUNCTIONS_DIR}/.ocf-shellfuncs

OCF_RESKEY_otrsuser_default=otrs
: ${OCF_RESKEY_otrsuser:=${OCF_RESKEY_otrsuser_default}}

if test -r /etc/sysconfig/otrs; then
    . /etc/sysconfig/otrs
else
    exit $OCF_ERR_INSTALLED
fi


# logger $0 $*

action_monitor(){
    # $OTRS_POSTMASTER というスクリプトが稼働・停止の内部フラグになっている.
    if [ -x $OTRS_POSTMASTER ] ; then
        return $OCF_SUCCESS
    else
        return $OCF_NOT_RUNNING
    fi
}

action_start(){
    if action_monitor ; then
        ocf_log warn 'Resource is already runnning'
        return $OCF_SUCCESS
    fi
    #### import code from /etc/init.d/otrs ####
    # Enable OTRS_POSTMASTER #
    if chmod 755 $OTRS_POSTMASTER ; then
        ocf_log info "Enable $OTRS_POSTMASTER ... done."
    else
        ocf_log err "Enable $OTRS_POSTMASTER ... failed."
        return $OCF_ERR_GENERIC
    fi

    # Check OTRS Spool dir #
    ocf_log info "Checking otrs spool dir...Start"
    for i in $OTRS_SPOOLDIR/* ; do
        # process old emails
        if echo $i | grep -v '*' >> /dev/null; then
            if $OTRS_POSTMASTER < $i >> /dev/null 2>&1 ; then
                if rm $i ; then
                    ocf_log info \
                        "Starting otrs PostMaster... ($i) (remove email) done.";
                else
                    ocf_log err \
                        "Starting otrs PostMaster... ($i) (remove email failed) done.";
                fi
            else
                ocf_log err "Starting otrs PostMaster... ($i) failed."
            fi
        fi
    done
    echo " done."

    # cron settings
    if test $OTRS_CRON_RUNNING -gt 0; then
        if  mkdir -p $OTRS_CRON_DIR; cd $OTRS_CRON_DIR && \
            ls * | grep -v '.dist'|grep -v '.save'|grep -v 'CVS'|grep -v '.rpm'| \
            xargs cat > $OTRS_CRON_TMP_FILE && \
            crontab $OTRS_CRON_USER $OTRS_CRON_TMP_FILE
        then
            ocf_log info " Creating cronjobs (source $OTRS_CRON_DIR/*) ... done."
        else
            ocf_log info " Creating cronjobs (source $OTRS_CRON_DIR/*) ... failed!"
            return $OCF_ERR_GENERIC
        fi
    else
        ocf_log info " Disabled: cronjobs!"
    fi


    #### end import code ###

    while ! action_monitor ; do
        ocf_log debug "Resource has not started yet, waiting"
        sleep 1
    done
    return $OCF_SUCCESS
}

action_stop(){
    local rc
    action_monitor
    rc=$?
    case "$rc" in
    "$OCF_SUCCESS")
        ocf_log debug "Resource is currently running"
        ;;
    "$OCF_NOT_RUNNING")
        ocf_log info "Resource is already stopped"
        return $OCF_SUCCESS
        ;;
    *)
        return $OCF_ERR_GENERIC
        ;;
    esac

    ### import code from /etc/init.d/otrs ###

    # disable otrs.PostMaster.pl
    if chmod 644 $OTRS_POSTMASTER; then
        ocf_log info "Disable $OTRS_POSTMASTER ... done."
    else
        ocf_log err  "Disable $OTRS_POSTMASTER ... failed."
    fi

    if [ $OTRS_CRON_RUNNING -gt 0 ] ; then
        if crontab $OTRS_CRON_USER -r ; then
            ocf_log info " Shutting down cronjobs ... done."
        else
            ocf_log err  " Shutting down cronjobs ... failed!"
            # return $OCF_ERR_GENERIC
        fi
    else
        ocf_log info " Disabled: cronjobs!"
    fi
    ocf_log info "Final shutdown of $OTRS_PROG.. done"
    ###

    while action_monitor ; do
        ocf_log debug "Resource has not stopped yet, waiting"
    done
    return $OCF_SUCCESS
}

action_metadata(){
        cat <<END
<?xml version="1.0"?>
<!DOCTYPE resource-agent SYSTEM "ra-api-1.dtd">
<resource-agent name="otrs">
<version>1.0</version>
<longdesc lang="en">
This is the resource agent for Borderless OTRS service.
</longdesc>
<shortdesc lang="en">Manages an Borderless OTRS service instance</shortdesc>
<parameters>
  <parameter name="otrsuser" unique="0" required="0">
     <longdesc  lang="en">OS-Username where OTRS running.</longdesc>
     <shortdesc lang="en">OS-Username where OTRS running.</shortdesc>
     <content type="string" default="${OCF_RESKEY_otrsuser_default}" />
  </parameter>
</parameters>
<actions>
<action name="start"   timeout="40s" />
<action name="stop"    timeout="60s" />
<action name="monitor" depth="0"  timeout="20s" interval="10" />
<action name="meta-data"  timeout="5" />
</actions>
</resource-agent>
END
        return $OCF_SUCCESS
}

action_validate(){
        if [ -f /etc/init.d/otrs ]; then
                return $OCF_SUCCESS
        else
                return $OCF_ERR_INSTALLED
        fi
}

case "$__OCF_ACTION" in
status|monitor)
        action_monitor ;;
start)
        action_start   ;;
stop)
        action_stop ;;
meta-data)
        action_metadata ;;
validate-all)
        action_validate ;;
*)
        exit $OCF_ERR_UNIMPLEMENTED
esac
rc=$?
ocf_log debug "${OCF_RESOURCE_INSTANCE} $__OCF_ACTION returned $rc"
# logger RETURN=$rc
exit $rc

