import javax.script.*;
import org.mozilla.javascript.*;

public class MyClassShutter implements ClassShutter {
    public boolean visibleToScripts(String fullclassName){
        if( fullclassName.startsWith("java.") ){
            return true;
        }else{
            return false;
        }
    }
}
